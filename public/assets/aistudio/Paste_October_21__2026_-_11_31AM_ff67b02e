    const timer = setTimeout(() => {
      updateLinePositions();
    }, 100);

    const handleResize = () => {
      updateLinePositions();
    };

    window.addEventListener('resize', handleResize);
    return () => {
      clearTimeout(timer);
      window.removeEventListener('resize', handleResize);
    };
