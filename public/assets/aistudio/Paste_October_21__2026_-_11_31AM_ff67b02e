  const targetRefs = useRef<Record<string, HTMLElement | null>>({});

  // Computed lines state: Array of { id, x1, y1, x2, y2, isRight }
  const [lineCoords, setLineCoords] = useState<
    Array<{
      id: string;
      num: number;
      x1: number;
      y1: number;
      x2: number;
      y2: number;
      side: 'left' | 'right';
    }>
  >([]);

  // Function to register card ref
  const setCardRef = (id: string, el: HTMLElement | null) => {
    cardRefs.current[id] = el;
  };

  // Function to register target ref
  const setTargetRef = (id: string, el: HTMLElement | null) => {
    targetRefs.current[id] = el;
  };

  // Recalculate line positions
  const updateLinePositions = () => {
    if (!containerRef.current) return;
    const containerRect = containerRef.current.getBoundingClientRect();
    const newCoords: Array<{
      id: string;
      num: number;
      x1: number;
      y1: number;
      x2: number;
      y2: number;
      side: 'left' | 'right';
    }> = [];

    const activeList = screenCallouts[activeScreenTab] || [];

    activeList.forEach((item) => {
      const cardEl = cardRefs.current[item.id];
      const targetEl = targetRefs.current[item.id];

      if (cardEl && targetEl) {
        const cardRect = cardEl.getBoundingClientRect();
        const targetRect = targetEl.getBoundingClientRect();

        let x1 = 0;
        let y1 = cardRect.top + cardRect.height / 2 - containerRect.top;
        let x2 = 0;
        let y2 = targetRect.top + targetRect.height / 2 - containerRect.top;

        if (item.side === 'left') {
          // Card is on left, connect from right edge of card to left edge of target
          x1 = cardRect.right - containerRect.left;
          x2 = targetRect.left - containerRect.left;
        } else {
          // Card is on right, connect from left edge of card to right edge of target
          x1 = cardRect.left - containerRect.left;
          x2 = targetRect.right - containerRect.left;
        }

        newCoords.push({
          id: item.id,
          num: item.num,
          x1,
          y1,
          x2,
          y2,
          side: item.side,
        });
      }
    });

    setLineCoords(newCoords);
  };

