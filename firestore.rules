rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerRole() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function isOwnerOfLaundry(laundryId) {
      return isSignedIn() && (
        isOwnerRole() ||
        (exists(/databases/$(database)/documents/laundries/$(laundryId)) &&
         get(/databases/$(database)/documents/laundries/$(laundryId)).data.ownerId == request.auth.uid)
      );
    }

    // 0. Brand registry for public web profiles
    match /brands_registry/{slug} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 1. Team staff collection
    match /tim_studio/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // 2. Owners collection
    match /owners/{ownerId} {
      allow read, write: if isSignedIn() && request.auth.uid == ownerId;

      match /{subcollection}/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == ownerId;
      }
    }

    // 3. User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // 4. Laundries and their nested resources (transaksi, pelanggan, layanan, pengeluaran, settings)
    match /laundries/{laundryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwnerOfLaundry(laundryId);
      allow delete: if isOwnerOfLaundry(laundryId);

      // Transaksi: Kasir & Owner dapat membuat & mengupdate status/pelunasan, HAPUS HANYA UNTUK OWNER
      match /transaksi/{transaksiId} {
        allow read, create, update: if isSignedIn();
        allow delete: if isOwnerOfLaundry(laundryId);
      }

      // Pelanggan: Kasir & Owner dapat mengelola data pelanggan, HAPUS HANYA UNTUK OWNER
      match /pelanggan/{pelangganId} {
        allow read, create, update: if isSignedIn();
        allow delete: if isOwnerOfLaundry(laundryId);
      }

      // Pengeluaran / Arus Kas: Kasir & Owner dapat membaca dan mencatat, HAPUS/EDIT HANYA UNTUK OWNER
      match /pengeluaran/{pengeluaranId} {
        allow read, create: if isSignedIn();
        allow update, delete: if isOwnerOfLaundry(laundryId);
      }

      // Pengaturan Outlet & Layanan: Hanya Owner yang berhak mengubah tarif dan konfigurasi toko
      match /layanan/{layananId} {
        allow read: if isSignedIn();
        allow write: if isOwnerOfLaundry(laundryId);
      }

      match /settings/{docId} {
        allow read: if isSignedIn();
        allow write: if isOwnerOfLaundry(laundryId);
      }

      // Subkoleksi lain yang belum dideklarasikan: Hanya Owner
      match /{subcollection}/{docId} {
        allow read: if isSignedIn();
        allow write: if isOwnerOfLaundry(laundryId);
      }
    }

    match /test/{docId} {
      allow read: if true;
    }

    // Default global deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
