rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerOfLaundry(laundryId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/laundries/$(laundryId)) &&
        get(/databases/$(database)/documents/laundries/$(laundryId)).data.ownerId == request.auth.uid;
    }

    // 0. Brand registry for public web profiles
    match /brands_registry/{slug} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 1. Team staff collection
    match /tim_studio/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // 2. Owners collection
    match /owners/{ownerId} {
      allow read, write: if isSignedIn() && request.auth.uid == ownerId;

      match /{subcollection}/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == ownerId;
      }
    }

    // 3. User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // 4. Laundries and their nested resources (transaksi, pelanggan, layanan, pengeluaran, settings)
    match /laundries/{laundryId} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || request.auth.uid != null);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /{subcollection}/{docId} {
        allow read, write: if isOwnerOfLaundry(laundryId) || (isSignedIn() && request.auth != null);
      }
    }

    // Default global deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
