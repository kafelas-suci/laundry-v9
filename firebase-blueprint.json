{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil pengguna owner atau kasir laundry dengan kolom saldo dan langganan yang dikunci khusus server",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "emailOrPhone": { "type": "string", "maxLength": 160 },
        "authEmail": { "type": "string", "maxLength": 160 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "username": { "type": "string", "maxLength": 120 },
        "nomorTelepon": { "type": "string", "maxLength": 40 },
        "role": { "type": "string", "enum": ["owner", "admin", "karyawan"] },
        "laundryId": { "type": "string", "maxLength": 128 },
        "laundries": { "type": "object" },
        "walletBalance": { "type": "number" },
        "subscriptionType": { "type": "string", "enum": ["newcomer", "premium"] },
        "subscriptionEndDate": { "type": "number" },
        "lastSettledOrderId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "role", "laundryId", "walletBalance"]
    },
    "PaymentOrder": {
      "title": "PaymentOrder",
      "description": "Catatan pesanan pembayaran Midtrans yang hanya dapat ditulis oleh server backend",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "purpose": { "type": "string", "enum": ["extend_premium", "topup_wallet"] },
        "amount": { "type": "number" },
        "durationDays": { "type": "number" },
        "snapToken": { "type": "string", "maxLength": 256 },
        "redirectUrl": { "type": "string", "maxLength": 512 },
        "status": { "type": "string", "enum": ["pending", "settled", "failed", "expired"] },
        "credited": { "type": "boolean" },
        "paymentType": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "settledAt": { "type": "number" }
      },
      "required": ["orderId", "ownerId", "purpose", "amount", "status", "credited", "createdAt"]
    },
    "BillingAuditLog": {
      "title": "BillingAuditLog",
      "description": "Buku besar audit mutasi saldo dompet, perpanjangan langganan, aktivasi cabang, dan persetujuan transfer manual",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 160 },
        "action": {
          "type": "string",
          "enum": [
            "midtrans_extend_premium",
            "midtrans_topup_wallet",
            "wallet_extend_premium",
            "wallet_activate_branch",
            "admin_extend_premium",
            "admin_topup_wallet"
          ]
        },
        "channel": {
          "type": "string",
          "enum": ["MIDTRANS", "WALLET", "BRI", "DANA", "MANUAL"]
        },
        "amount": { "type": "number" },
        "walletDelta": { "type": "number" },
        "walletBefore": { "type": "number" },
        "walletAfter": { "type": "number" },
        "durationDays": { "type": "number" },
        "subscriptionTypeAfter": { "type": "string", "enum": ["newcomer", "premium"] },
        "subscriptionEndDateAfter": { "type": "number" },
        "note": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "number" }
      },
      "required": [
        "id",
        "uid",
        "actorUid",
        "action",
        "channel",
        "amount",
        "walletDelta",
        "walletBefore",
        "walletAfter",
        "createdAt"
      ]
    },
    "LaundryBranch": {
      "title": "LaundryBranch",
      "description": "Informasi cabang toko laundry dengan proteksi status langganan khusus server",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "namaLaundry": { "type": "string", "minLength": 1, "maxLength": 120 },
        "alamat": { "type": "string", "maxLength": 300 },
        "nomorTelepon": { "type": "string", "maxLength": 40 },
        "subscriptionType": { "type": "string", "enum": ["newcomer", "premium"] },
        "subscriptionEndDate": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "ownerId", "namaLaundry"]
    },
    "LaundryStaff": {
      "title": "LaundryStaff",
      "description": "Registri akun kasir resmi yang ditugaskan pada cabang laundry",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "laundryId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 120 },
        "emailOrPhone": { "type": "string", "maxLength": 160 },
        "authEmail": { "type": "string", "maxLength": 160 },
        "nomorTelepon": { "type": "string", "maxLength": 40 },
        "role": { "type": "string", "enum": ["admin", "karyawan"] },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "ownerId", "laundryId", "displayName", "role"]
    },
    "LaundryTransaksi": {
      "title": "LaundryTransaksi",
      "description": "Dokumen transaksi pesanan laundry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "laundryId": { "type": "string" },
        "nomorTransaksi": { "type": "string" },
        "namaPelanggan": { "type": "string" },
        "nomorTelepon": { "type": "string" },
        "totalHarga": { "type": "number" },
        "jumlahDp": { "type": "number" },
        "status": { "type": "string" },
        "statusPembayaran": { "type": "string" },
        "tanggalMasuk": { "type": "number" },
        "tanggalSelesai": { "type": "number" }
      },
      "required": ["id", "laundryId", "namaPelanggan", "totalHarga", "status", "statusPembayaran"]
    },
    "LaundryPelanggan": {
      "title": "LaundryPelanggan",
      "description": "Data pelanggan laundry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "laundryId": { "type": "string" },
        "nama": { "type": "string" },
        "nomorTelepon": { "type": "string" },
        "poin": { "type": "number" }
      },
      "required": ["id", "laundryId", "nama"]
    },
    "LaundryLayanan": {
      "title": "LaundryLayanan",
      "description": "Daftar paket dan harga layanan laundry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "laundryId": { "type": "string" },
        "nama": { "type": "string" },
        "harga": { "type": "number" },
        "satuanHarga": { "type": "string" },
        "durasi": { "type": "string" }
      },
      "required": ["id", "laundryId", "nama", "harga"]
    },
    "LaundryPengeluaran": {
      "title": "LaundryPengeluaran",
      "description": "Catatan pengeluaran operasional toko",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "laundryId": { "type": "string" },
        "tanggal": { "type": "number" },
        "keterangan": { "type": "string" },
        "jumlah": { "type": "number" }
      },
      "required": ["id", "laundryId", "keterangan", "jumlah"]
    },
    "LaundrySettings": {
      "title": "LaundrySettings",
      "description": "Pengaturan struk dan identitas laundry",
      "type": "object",
      "properties": {
        "appTitle": { "type": "string" },
        "headerStruk": { "type": "string" },
        "address": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "useLogo": { "type": "boolean" },
        "logoPath": { "type": "string" }
      },
      "required": ["appTitle"]
    },
    "PaymentGatewayConfig": {
      "title": "PaymentGatewayConfig",
      "description": "Konfigurasi publik alamat server backend pembayaran lintas-domain",
      "type": "object",
      "properties": {
        "backendUrl": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "number" }
      },
      "required": ["backendUrl", "updatedAt"]
    }
  },
  "firestore": {
    "/app_config/{configId}": {
      "schema": "PaymentGatewayConfig",
      "description": "Konfigurasi publik alamat backend pembayaran yang dikelola Super Admin"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Dokumen profil user dengan proteksi penuh saldo dan status langganan di sisi server"
    },
    "/payment_orders/{orderId}": {
      "schema": "PaymentOrder",
      "description": "Catatan pesanan pembayaran Midtrans (read-only bagi pemilik, write khusus server)"
    },
    "/billing_audit_logs/{logId}": {
      "schema": "BillingAuditLog",
      "description": "Buku besar audit mutasi saldo dan langganan bersifat append-only"
    },
    "/laundries/{laundryId}": {
      "schema": "LaundryBranch",
      "description": "Dokumen data cabang laundry terisolasi per owner dengan aktivasi cabang ekstra via backend"
    },
    "/laundries/{laundryId}/staff/{staffUid}": {
      "schema": "LaundryStaff",
      "description": "Sub-koleksi registri akun kasir cabang"
    },
    "/laundries/{laundryId}/transaksi/{transaksiId}": {
      "schema": "LaundryTransaksi",
      "description": "Sub-koleksi transaksi laundry"
    },
    "/laundries/{laundryId}/pelanggan/{pelangganId}": {
      "schema": "LaundryPelanggan",
      "description": "Sub-koleksi pelanggan laundry"
    },
    "/laundries/{laundryId}/layanan/{layananId}": {
      "schema": "LaundryLayanan",
      "description": "Sub-koleksi paket layanan laundry"
    },
    "/laundries/{laundryId}/pengeluaran/{pengeluaranId}": {
      "schema": "LaundryPengeluaran",
      "description": "Sub-koleksi pengeluaran operasional"
    },
    "/laundries/{laundryId}/settings/{settingId}": {
      "schema": "LaundrySettings",
      "description": "Sub-koleksi pengaturan cabang laundry"
    }
  }
}
